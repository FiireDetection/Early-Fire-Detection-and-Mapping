.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Logs / temp / debug artifacts
*.log
**/logs/
tmp/
temp/
**/tmp/
**/temp/
debug_out/
wandb/

# Hugging Face / generic caches (local + CI)
.cache/
**/.cache/
.huggingface/

# Data / artifacts (large) - root only, NOT src/data/ Python modules
/data/
/data.rar
/outputs/

# Optional UI demo clips - ignore binaries; allow a tracked empty placeholder
/samples/*
!/samples/.gitkeep

# Models can be large - root models/ folder and common model artifact files
/models/
*.pt
*.pkl
*.h5
*.safetensors

# Code archives should not be shipped in the repo
*.zip

# Scratch / local encodes
scratch_videos/
upload_temp/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.vs/

# Streamlit local secrets
.streamlit/secrets.toml

# Local environment / secrets
.env
.env.*
!.env.example
